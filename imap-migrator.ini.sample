# IMAP migration configuration
#
# Each endpoint must use EXACTLY ONE authentication method:
#
# METHOD 1: normal IMAP password
#
#   password=your-password
#   token=
#   thunderbird_profile=
#
# METHOD 2: direct OAuth2 ACCESS TOKEN (XOAUTH2)
#
#   password=
#   token=your-OAuth2-ACCESS-token
#   thunderbird_profile=
#
# token= must be an ACCESS TOKEN accepted directly by the IMAP server. It is
# not a refresh token, authorization code, client secret, or dashboard entry.
#
# METHOD 3: reuse Microsoft OAuth already stored by Thunderbird
#
#   password=
#   token=
#   thunderbird_profile=~/.thunderbird/xxxxxxxx.yyy
#   thunderbird_primary_password=
#
# Thunderbird mode currently supports Microsoft/Outlook IMAP only. The script
# reads Thunderbird's encrypted OAuth refresh token from logins.json, decrypts
# it through key4.db using libnss3, asks Microsoft for a fresh IMAP access
# token, and then authenticates to IMAP using XOAUTH2.
#
# The Thunderbird profile is NOT modified and no OAuth token is copied into
# this INI file.
#
# If Thunderbird uses a Primary Password, set it in
# thunderbird_primary_password=. Otherwise leave that line empty.
#
# Connections are always implicit TLS/SSL on TCP port 993.
# Relative profile paths are resolved relative to this INI; '~' is expanded.
# Keep this file private if it contains passwords:
#
#   chmod 600 imap-migrate.ini


[source]
server=imap.source.com
user=mememe@source.com

# Choose exactly one:
password=SOURCE-IMAP-PASSWORD
token=
thunderbird_profile=
thunderbird_primary_password=


[destination]
server=imap.destination.com
user=blahblah@destination.com

# Recommended here: reuse the Thunderbird profile in which this Outlook
# account already works with Authentication method = OAuth2.
password=
token=
thunderbird_profile=~/.thunderbird/xxxxxxxx.default-release
thunderbird_primary_password=


[migration]
# All source folders are recreated below this dedicated destination folder.
# Example: source INBOX -> TheSource/INBOX
destination_root=TheSource
