# Named IMAP accounts. Section names are aliases used by --from / --to.
# An email address can also be a section name, e.g. [account@gmail.com].
# Roles are chosen by each command; no account is permanently source/destination.
# Copy this file to imap-migrator.ini and replace the example credentials.
# Keep credentials private: chmod 600 imap-migrator.ini
# Connections use implicit TLS on TCP port 993.
#
# Each selected account must set EXACTLY ONE of:
#   password=              IMAP password or provider app password
#   token=                 current IMAP OAuth ACCESS token, not a refresh token
#   thunderbird_profile=   existing Thunderbird OAuth profile (Google/Microsoft)
# Thunderbird must already have this exact account configured with OAuth2.
# Profiles are read without modification; NSS/libnss3 is required.
# Relative profile paths are resolved beside this INI; ~ is expanded.
# If the profile has a Primary Password, set thunderbird_primary_password=.

[gmail]
server = imap.gmail.com
user = account@gmail.com
thunderbird_profile = ~/.thunderbird/xxxxxxxx.default-release
thunderbird_primary_password =

[hotmail]
server = outlook.office365.com
user = account@hotmail.com
thunderbird_profile = ~/.thunderbird/xxxxxxxx.default-release
thunderbird_primary_password =

[gmx]
server = imap.gmx.com
user = account@gmx.com
password = REPLACE-WITH-IMAP-PASSWORD

[defaults]
# Automatically selected journals live here. Relative to this INI, not the cwd.
# Account identities, destination root and archive identity select separate files.
# Keep this directory when resuming. Override one run with --journal PATH.
state_dir = imap-migrator-state

# Batch size limits. A single oversized message is transferred alone.
batch_messages = 25
batch_mib = 16
retries = 4

# Destinations, roots, archive paths, reports and progress are command-line choices.
# Examples:
#   python3 imap-migrator.py migrate --from gmx --to gmail --root GMX
#   python3 imap-migrator.py export  --from gmx --to ./gmx-backup
#   python3 imap-migrator.py import  --from ./gmx-backup    --to hotmail --root GMX
#   python3 imap-migrator.py verify  --archive ./gmx-backup --to hotmail --root GMX --report verify.tsv
